# For docker-compose.yml, set both values in a local ignored .env file.
# PAPERCLIP_DB_PASSWORD=<long URL-safe random value>
# BETTER_AUTH_SECRET=<at least 32 random characters>
# For local development with an external DB, set DATABASE_URL explicitly.
# DATABASE_URL=postgres://paperclip:<encoded-password>@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
